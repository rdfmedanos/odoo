<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_andreani" model="ir.ui.view">
        <field name="name">delivery.carrier.form.andreani</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Andreani" invisible="delivery_type != 'andreani'">
                    <group string="Credenciales">
                        <group>
                            <field name="andreani_username"/>
                            <field name="andreani_password" password="True"/>
                            <field name="andreani_client_number"/>
                            <field name="andreani_contract_number"/>
                            <field name="andreani_env" widget="radio"/>
                        </group>
                        <group>
                            <field name="andreani_volumetric_divisor"/>
                            <field name="andreani_token" readonly="1"/>
                            <field name="andreani_token_expires" readonly="1"/>
                            <button name="action_test_andreani_credentials" string="Probar credenciales" type="object" class="oe_highlight"/>
                        </group>
                    </group>
                    <group string="Origen">
                        <group>
                            <field name="andreani_origin_zip"/>
                        </group>
                        <group string="Defaults">
                            <field name="andreani_default_weight_g"/>
                            <field name="andreani_default_length_cm"/>
                            <field name="andreani_default_width_cm"/>
                            <field name="andreani_default_height_cm"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
