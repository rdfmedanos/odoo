<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_idearte_local_experience" name="Local Físico Idearte">
        <section id="local-section" class="s_idearte_local_experience py-5 bg-beige-suave position-relative" style="background-color: var(--color-beige-suave);">
            <!-- Subtle colorful circles behind -->
            <div class="position-absolute" style="bottom: 10%; left: 5%; width: 120px; height: 120px; background-color: var(--color-naranja); border-radius: 50%; filter: blur(40px); opacity: 0.15; pointer-events: none;"></div>
            <div class="position-absolute" style="top: 10%; right: 5%; width: 140px; height: 140px; background-color: var(--color-fucsia); border-radius: 50%; filter: blur(55px); opacity: 0.12; pointer-events: none;"></div>
            
            <div class="container py-4 position-relative" style="z-index: 1;">
                <div class="row align-items-center">
                    <div class="col-lg-6 mb-5 mb-lg-0 pr-lg-5">
                        <span class="text-fucsia font-weight-bold uppercase" style="font-family: var(--font-headings); font-size: 0.9rem; letter-spacing: 0.1em;">EXPERIENCIA EN EL LOCAL</span>
                        <h2 class="display-4 mt-2 mb-4 font-weight-bold" style="font-family: var(--font-headings); line-height: 1.2;">
                            Vení a conocernos y <span class="art-title-highlight highlight-naranja">despertá tu creatividad</span>
                        </h2>
                        <p class="lead text-dark mb-4" style="font-size: 1.15rem; line-height: 1.7;">
                            Encontrá el espacio perfecto para elegir tus materiales, ver la calidad del fibrofácil en persona, inspirarte con ideas terminadas y recibir nuestro asesoramiento personalizado.
                        </p>
                        
                        <div class="row g-3 mb-5">
                            <div class="col-sm-6 d-flex align-items-start gap-2">
                                <span class="text-fucsia mt-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                </span>
                                <div>
                                    <h4 class="h6 font-weight-bold mb-1">Gran Variedad en Stock</h4>
                                    <p class="text-muted small mb-0">Miles de figuras, cajas, letras y soportes listos para llevar.</p>
                                </div>
                            </div>
                            <div class="col-sm-6 d-flex align-items-start gap-2">
                                <span class="text-violeta mt-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                </span>
                                <div>
                                    <h4 class="h6 font-weight-bold mb-1">Asesoramiento Experto</h4>
                                    <p class="text-muted small mb-0">Te ayudamos a elegir los mejores materiales y técnicas.</p>
                                </div>
                            </div>
                            <div class="col-sm-6 d-flex align-items-start gap-2">
                                <span class="text-azul mt-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                </span>
                                <div>
                                    <h4 class="h6 font-weight-bold mb-1">Retiro Inmediato</h4>
                                    <p class="text-muted small mb-0">Comprás online y retirás gratis en nuestro local físico.</p>
                                </div>
                            </div>
                            <div class="col-sm-6 d-flex align-items-start gap-2">
                                <span class="text-verde mt-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                </span>
                                <div>
                                    <h4 class="h6 font-weight-bold mb-1">Pedidos a Medida</h4>
                                    <p class="text-muted small mb-0">Traés tu diseño y lo fabricamos en fibrofácil o Router CNC.</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="d-flex flex-column flex-sm-row gap-3 align-items-sm-center">
                            <a href="https://maps.google.com" target="_blank" class="btn art-btn px-4 py-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                Cómo Llegar al Local
                            </a>
                        </div>
                    </div>
                    
                    <div class="col-lg-6">
                        <div class="row g-3">
                            <div class="col-8">
                                <div class="art-gallery-img" style="box-shadow: 0 15px 30px rgba(0,0,0,0.04); border: 6px solid white; transform: rotate(-2deg);">
                                    <img src="/theme_idearte_artistica/static/src/img/localidearte.jpg" alt="Local Idearte Artística" class="img-fluid w-100" style="object-fit: cover; height: 320px; display: block;"/>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="art-gallery-img" style="box-shadow: 0 15px 30px rgba(0,0,0,0.04); border: 6px solid white; transform: translateY(40px) rotate(3deg);">
                                    <img src="/theme_idearte_artistica/static/src/img/local_shop.png" alt="Interior Tienda Fibrofácil" class="img-fluid w-100" style="object-fit: cover; height: 150px; display: block;"/>
                                </div>
                            </div>
                            <div class="col-12 mt-4">
                                <div class="art-card p-4 d-flex align-items-center gap-4 bg-white" style="margin-left: 20px; transform: translateY(20px);">
                                    <div class="p-3 bg-fucsia rounded-circle text-white">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                    </div>
                                    <div>
                                        <h4 class="h5 font-weight-bold mb-1">¿Consultas telefónicas?</h4>
                                        <p class="text-muted mb-0">Llamanos o escribinos al WhatsApp ante cualquier duda.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="art-card p-4 d-flex align-items-center gap-4 bg-white" style="margin-left: 20px;">
                                    <div class="p-3 bg-fucsia rounded-circle text-white">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    </div>
                                    <div>
                                        <h4 class="h5 font-weight-bold mb-1">Dirección y Horarios</h4>
                                        <p class="text-muted mb-0">Av. Principal 123 - Lunes a Sábados 9:00 a 19:30</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
