<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_idearte_featured_products" name="Productos Destacados Idearte">
        <section class="s_idearte_featured_products py-5" style="background-color: var(--color-marfil);">
            <div class="container py-4">
                <div class="row mb-5 align-items-end">
                    <div class="col-md-8 text-center text-md-start">
                        <span class="text-fucsia font-weight-bold uppercase" style="font-family: var(--font-headings); font-size: 0.9rem; letter-spacing: 0.1em;">SELECCIÓN DE LA CASA</span>
                        <h2 class="display-5 mt-2 font-weight-bold" style="font-family: var(--font-headings);">
                            Productos <span class="art-title-highlight highlight-fucsia">Destacados</span>
                        </h2>
                    </div>
                    <div class="col-md-4 text-center text-md-end mt-3 mt-md-0">
                        <a href="/shop" class="btn art-btn btn-secondary-art">Ver Catálogo Completo</a>
                    </div>
                </div>
                
                <div class="row g-4">
                    <!-- Product 1 -->
                    <div class="col-xl-3 col-lg-4 col-sm-6">
                        <div class="art-card h-100 d-flex flex-column">
                            <div class="position-relative overflow-hidden bg-light" style="height: 250px;">
                                <span class="position-absolute top-3 left-3 badge bg-fucsia text-white px-2.5 py-1.5 rounded-pill font-weight-bold z-index-2" style="font-size: 0.75rem; font-family: var(--font-headings); top: 12px; left: 12px;">NUEVO</span>
                                <img src="/theme_idearte_artistica/static/src/img/modelos1.png" alt="Letras 3D de Fibrofácil" class="w-100 h-100" style="object-fit: cover; object-position: center;"/>
                            </div>
                            <div class="p-4 d-flex flex-column flex-grow-1">
                                <span class="text-muted text-uppercase mb-1" style="font-size: 0.75rem; font-weight: 600;">Letras y nombres</span>
                                <h3 class="h5 font-weight-bold mb-2" style="font-family: var(--font-headings);">Letras de Fibrofácil 3D</h3>
                                <p class="text-muted small mb-3 flex-grow-1">Ideales para pintar con acrílico, decorar eventos o señalizar espacios.</p>
                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                    <span class="h5 font-weight-extrabold text-dark mb-0">$1.200</span>
                                    <a href="/shop" class="btn btn-sm btn-outline-dark rounded-circle p-2" title="Agregar al Carrito">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Product 2 -->
                    <div class="col-xl-3 col-lg-4 col-sm-6">
                        <div class="art-card h-100 d-flex flex-column card-violeta">
                            <div class="position-relative overflow-hidden bg-light" style="height: 250px;">
                                <span class="position-absolute top-3 left-3 badge bg-violeta text-white px-2.5 py-1.5 rounded-pill font-weight-bold z-index-2" style="font-size: 0.75rem; font-family: var(--font-headings); top: 12px; left: 12px;">MÁS VENDIDO</span>
                                <img src="/theme_idearte_artistica/static/src/img/modelos2.png" alt="Caja de Té con Divisiones" class="w-100 h-100" style="object-fit: cover; object-position: center;"/>
                            </div>
                            <div class="p-4 d-flex flex-column flex-grow-1">
                                <span class="text-muted text-uppercase mb-1" style="font-size: 0.75rem; font-weight: 600;">Manualidades</span>
                                <h3 class="h5 font-weight-bold mb-2" style="font-family: var(--font-headings);">Caja de Té Organizada</h3>
                                <p class="text-muted small mb-3 flex-grow-1">Caja con 6 divisiones y tapa de vidrio lista para decorar y personalizar.</p>
                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                    <span class="h5 font-weight-extrabold text-dark mb-0">$3.800</span>
                                    <a href="/shop" class="btn btn-sm btn-outline-dark rounded-circle p-2" title="Agregar al Carrito">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Product 3 -->
                    <div class="col-xl-3 col-lg-4 col-sm-6">
                        <div class="art-card h-100 d-flex flex-column card-azul">
                            <div class="position-relative overflow-hidden bg-light" style="height: 250px;">
                                <img src="/theme_idearte_artistica/static/src/img/modelos1.png" alt="Mandalas Calados Madera" class="w-100 h-100" style="object-fit: cover; object-position: center; filter: hue-rotate(90deg);"/>
                            </div>
                            <div class="p-4 d-flex flex-column flex-grow-1">
                                <span class="text-muted text-uppercase mb-1" style="font-size: 0.75rem; font-weight: 600;">Figuras Decorativas</span>
                                <h3 class="h5 font-weight-bold mb-2" style="font-family: var(--font-headings);">Mandala de Madera Calada</h3>
                                <p class="text-muted small mb-3 flex-grow-1">Corte láser de precisión para colgar. Diámetro 40cm de alta calidad.</p>
                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                    <span class="h5 font-weight-extrabold text-dark mb-0">$2.500</span>
                                    <a href="/shop" class="btn btn-sm btn-outline-dark rounded-circle p-2" title="Agregar al Carrito">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Product 4 -->
                    <div class="col-xl-3 col-lg-4 col-sm-6">
                        <div class="art-card h-100 d-flex flex-column">
                            <div class="position-relative overflow-hidden bg-light" style="height: 250px;">
                                <img src="/theme_idearte_artistica/static/src/img/modelos2.png" alt="Soportes y Candy Bar" class="w-100 h-100" style="object-fit: cover; object-position: center; filter: hue-rotate(180deg);"/>
                            </div>
                            <div class="p-4 d-flex flex-column flex-grow-1">
                                <span class="text-muted text-uppercase mb-1" style="font-size: 0.75rem; font-weight: 600;">Bases y Soportes</span>
                                <h3 class="h5 font-weight-bold mb-2" style="font-family: var(--font-headings);">Soporte para Cupcakes</h3>
                                <p class="text-muted small mb-3 flex-grow-1">Estructura encastrable de 3 pisos, ideal para Candy Bar o eventos.</p>
                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                    <span class="h5 font-weight-extrabold text-dark mb-0">$4.100</span>
                                    <a href="/shop" class="btn btn-sm btn-outline-dark rounded-circle p-2" title="Agregar al Carrito">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
