<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_idearte_featured_products" name="Productos Destacados Idearte">
        <t t-set="products" t-value="env['product.template'].search([('website_published', '=', True)], limit=4, order='write_date desc')"/>
        <t t-set="pricelist" t-value="env['product.pricelist'].search([], limit=1)"/>
        <section class="s_idearte_featured_products py-5" style="background-color: var(--color-marfil);">
            <div class="container py-4">
                <div class="row mb-5 align-items-end">
                    <div class="col-md-8 text-center text-md-start">
                        <span class="text-fucsia font-weight-bold uppercase" style="font-family: var(--font-headings); font-size: 0.9rem; letter-spacing: 0.1em;">SELECCIÓN DE LA CASA</span>
                        <h2 class="display-5 mt-2 font-weight-bold" style="font-family: var(--font-headings);">
                            Productos <span class="art-title-highlight highlight-fucsia">Destacados</span>
                        </h2>
                    </div>
                    <div class="col-md-4 text-center text-md-end mt-3 mt-md-0">
                        <a href="/shop" class="btn art-btn btn-secondary-art">Ver Catálogo Completo</a>
                    </div>
                </div>

                <div class="row g-4">
                    <t t-foreach="products" t-as="product">
                        <t t-set="info" t-value="product.product_variant_id.sudo().with_context(pricelist=pricelist.id)._get_combination_info_v2(product_template_id=product.id, pricelist=pricelist.id, only_template=True)"/>
                        <div class="col-xl-3 col-lg-4 col-sm-6">
                            <div class="art-card h-100 d-flex flex-column">
                                <div class="position-relative overflow-hidden bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                                    <img t-att-src="image_data_uri(product.image_1920)" t-att-alt="product.name" class="w-100 h-100" style="object-fit: cover; object-position: center;"/>
                                </div>
                                <div class="p-4 d-flex flex-column flex-grow-1">
                                    <span class="text-muted text-uppercase mb-1" style="font-size: 0.75rem; font-weight: 600;">
                                        <t t-esc="product.categ_id.name"/>
                                    </span>
                                    <h3 class="h5 font-weight-bold mb-2" style="font-family: var(--font-headings);">
                                        <t t-esc="product.name"/>
                                    </h3>
                                    <p class="text-muted small mb-3 flex-grow-1">
                                        <t t-esc="product.description_sale or ''"/>
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center mt-auto">
                                        <span class="h5 font-weight-extrabold text-dark mb-0">
                                            <t t-esc="info['price']" t-options="{'widget': 'monetary', 'display_currency': env.company.currency_id}"/>
                                        </span>
                                        <a t-att-href="product.website_url" class="btn btn-sm btn-outline-dark rounded-circle p-2" title="Ver producto">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </section>
    </template>
</odoo>
