                <div class="cnc-block-container p-5 position-relative overflow-hidden">
                    <!-- Tech overlay design -->
                    <div class="position-absolute" style="top: -50px; right: -50px; width: 250px; height: 250px; background: radial-gradient(circle, rgba(37, 99, 235, 0.15) 0%, rgba(255,255,255,0) 70%); border-radius: 50%; pointer-events: none;"></div>
