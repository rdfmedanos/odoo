<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Homepage layout -->
    <template id="homepage" inherit_id="website.homepage" name="Idearte Homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
                <!-- Pre-populated snippets that make up the Idearte homepage -->
                <t t-call="theme_idearte_artistica.s_idearte_hero"/>
                <t t-call="theme_idearte_artistica.s_idearte_categories"/>
                <t t-call="theme_idearte_artistica.s_idearte_featured_products"/>
                <t t-call="theme_idearte_artistica.s_idearte_local_experience"/>
                <t t-call="theme_idearte_artistica.s_idearte_gallery"/>
                <t t-call="theme_idearte_artistica.s_idearte_cnc_section"/>
                <t t-call="theme_idearte_artistica.s_idearte_final_cta"/>
            </div>
        </xpath>
    </template>

    <!-- Head layout override for Google Fonts -->
    <template id="layout" inherit_id="website.layout" name="Idearte Layout">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;family=Outfit:wght@400;600;700;800&amp;display=swap" rel="stylesheet"/>
        </xpath>
    </template>

    <!-- Custom Menu Items for Purchase-Oriented Navigation -->
    <data noupdate="1">
        <record id="menu_local" model="website.menu">
            <field name="name">Local</field>
            <field name="url">/#local-section</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">45</field>
        </record>
        <record id="menu_cnc" model="website.menu">
            <field name="name">CNC a Medida</field>
            <field name="url">/contactus?subject=Presupuesto%20Corte%20CNC</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">48</field>
        </record>
    </data>
</odoo>
