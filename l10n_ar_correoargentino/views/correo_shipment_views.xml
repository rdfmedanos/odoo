<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ar_correo_shipment_tree_view" model="ir.ui.view">
        <field name="name">l10n.ar.correo.shipment.tree</field>
        <field name="model">l10n_ar.correo.shipment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="delivery_type"/>
                <field name="agency_name"/>
                <field name="tracking_number"/>
                <field name="state"/>
                <field name="latest_status"/>
                <field name="latest_event_date"/>
            </list>
        </field>
    </record>

    <record id="l10n_ar_correo_shipment_form_view" model="ir.ui.view">
        <field name="name">l10n.ar.correo.shipment.form</field>
        <field name="model">l10n_ar.correo.shipment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_refresh_tracking" string="Actualizar tracking" type="object" class="oe_highlight"/>
                    <button name="action_fetch_label" string="Generar etiqueta" type="object"/>
                    <button name="action_download_label" string="Descargar etiqueta" type="object" invisible="not label_file"/>
                    <button name="action_cancel_remote" string="Cancelar envio" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,to_post,posted,in_transit,available_for_pickup,delivered,cancelled,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="sale_order_id"/>
                            <field name="picking_id"/>
                            <field name="carrier_id"/>
                            <field name="partner_id"/>
                            <field name="delivery_type"/>
                            <field name="visible_state" readonly="1"/>
                        </group>
                        <group>
                            <field name="tracking_number"/>
                            <field name="remote_order_id"/>
                            <field name="product_name"/>
                            <field name="product_type"/>
                            <field name="service_type"/>
                            <field name="label_filename"/>
                        </group>
                    </group>
                    <group>
                        <group string="Sucursal">
                            <field name="agency_code"/>
                            <field name="agency_name"/>
                            <field name="agency_address"/>
                        </group>
                        <group string="Ultimo evento">
                            <field name="latest_status_code"/>
                            <field name="latest_status"/>
                            <field name="latest_event_date"/>
                            <field name="latest_facility"/>
                            <field name="latest_event_summary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tracking JSON">
                            <field name="events_json" widget="text" readonly="1"/>
                        </page>
                        <page string="Payloads">
                            <field name="request_payload" widget="text" readonly="1"/>
                            <field name="response_payload" widget="text" readonly="1"/>
                            <field name="error_message" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ar_correo_shipment_search_view" model="ir.ui.view">
        <field name="name">l10n.ar.correo.shipment.search</field>
        <field name="model">l10n_ar.correo.shipment</field>
        <field name="arch" type="xml">
            <search>
                <field name="tracking_number"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <filter string="Por llevar al correo" name="to_post" domain="[('state', '=', 'to_post')]"/>
                <filter string="En transito" name="in_transit" domain="[('state', '=', 'in_transit')]"/>
                <filter string="Entregados" name="delivered" domain="[('state', '=', 'delivered')]"/>
                <filter string="Con error" name="error" domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Tipo entrega" name="group_delivery_type" context="{'group_by': 'delivery_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_ar_correo_shipment_action" model="ir.actions.act_window">
        <field name="name">Envios Correo Argentino</field>
        <field name="res_model">l10n_ar.correo.shipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="l10n_ar_correo_shipment_search_view"/>
    </record>

    <menuitem id="l10n_ar_correo_shipment_menu_root" name="Correo Argentino" parent="stock.menu_stock_root" sequence="95"/>
    <menuitem id="l10n_ar_correo_shipment_menu" name="Envios" parent="l10n_ar_correo_shipment_menu_root" action="l10n_ar_correo_shipment_action" sequence="10"/>
    <menuitem id="l10n_ar_correo_shipment_sale_menu" name="Envios Correo" parent="sale.sale_menu_root" action="l10n_ar_correo_shipment_action" sequence="65"/>
</odoo>
