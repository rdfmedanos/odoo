<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_l10n_ar_correoargentino" model="ir.ui.view">
        <field name="name">product.template.form.l10n.ar.correoargentino</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='weight']" position="after">
                <field name="l10n_ar_length_cm"/>
                <field name="l10n_ar_width_cm"/>
                <field name="l10n_ar_height_cm"/>
            </xpath>
        </field>
    </record>
</odoo>
