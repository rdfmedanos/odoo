<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_andreani" model="ir.ui.view">
        <field name="name">res.config.settings.andreani</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="o_settings_container">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <div class="o_checkbox">
                            <field name="andreani_username" invisible="1"/>
                        </div>
                    </div>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Andreani</span>
                        <div class="text-muted">
                            Configuración de la integración con Andreani
                        </div>
                        <div class="content-group mt16" groups="base.group_system">
                            <div class="row mt16">
                                <div class="col-6">
                                    <label for="andreani_username" string="Usuario API"/>
                                    <field name="andreani_username" class="oe_inline"/>
                                </div>
                                <div class="col-6">
                                    <label for="andreani_password" string="Contraseña API"/>
                                    <field name="andreani_password" password="True" class="oe_inline"/>
                                </div>
                            </div>
                            <div class="row mt16">
                                <div class="col-6">
                                    <label for="andreani_client_number" string="Nro. Cliente"/>
                                    <field name="andreani_client_number" class="oe_inline"/>
                                </div>
                                <div class="col-6">
                                    <label for="andreani_contract_number" string="Nro. Contrato"/>
                                    <field name="andreani_contract_number" class="oe_inline"/>
                                </div>
                            </div>
                            <div class="row mt16">
                                <div class="col-6">
                                    <label for="andreani_env" string="Entorno"/>
                                    <field name="andreani_env" widget="radio" class="oe_inline"/>
                                </div>
                                <div class="col-6">
                                    <label for="andreani_volumetric_divisor" string="Divisor volumétrico"/>
                                    <field name="andreani_volumetric_divisor" class="oe_inline"/>
                                </div>
                            </div>
                            <div class="row mt16">
                                <div class="col-12">
                                    <button name="action_test_andreani_credentials" string="Probar credenciales" type="object" class="btn-primary"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
