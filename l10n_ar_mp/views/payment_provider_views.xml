<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_mercado_pago" model="ir.ui.view">
        <field name="name">payment.provider.form.mercado.pago</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="after">
                <group string="Mercado Pago Checkout API Orders" invisible="code != 'mercado_pago'" groups="base.group_system">
                    <field name="l10n_ar_mp_client_id"/>
                    <field name="l10n_ar_mp_client_secret" password="True"/>
                    <field name="l10n_ar_mp_webhook_url" readonly="1"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
